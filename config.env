CONFIG_ENV=config.env
# ============================================================ Kernel source ==
# 用你自己 fork 的 OPPO 官方源码（唯一改动：注释掉 init/Kconfig 里
# source "kernel/sched_assist/Kconfig"，因为 OPPO 没公开那个目录）
KERNEL_SOURCE=https://github.com/Foehnnn/android_kernel_oppo_mt6877
KERNEL_SOURCE_BRANCH=oppo/mt6877_r_12.0_oppo_reno7_se_5g
# 已核实存在：arch/arm64/configs/oplus6877_defconfig
KERNEL_CONFIG=oplus6877_defconfig
# 已核实 arch/arm64/boot/Makefile 里有 Image.gz-dtb 目标，
# 且 defconfig 里 CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="mediatek/mt6877"
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=oplus6877
ADD_LOCALVERSION_TO_FILENAME=false
# stackp-name= 是空的：绕过内核 Makefile 里那个静默失败的工具链检查
# （prepare-compiler-check 的 cc-option 探针失败时不打印原因），
# 但 -fstack-protector-strong 仍然保留在 KBUILD_CFLAGS 里，
# 真不支持的话第一次编译就会明确报出来，而不是笼统的"defconfig 失败"。
EXTRA_CMDS:LD=ld.lld stackp-name=
# 4.14 的 MTK 树不能全 LLVM，必须给 GCC 做 binutils 和 --target
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
# =================================================================== Clang ==
# 4.9-4.19 的安全组合，新版 clang 在这棵树上会挂
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false
# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-
# =============================================================== KernelSU ===
# 官方 tiann/KernelSU 自 v1.0 起放弃 Non-GKI，4.14 用它只会锁在 v0.9.5。
# 改用 SukiSU-Ultra：builtin = 源码内置树，4.14 这种非 GKI 内核必须用这个 ref，
# 而且是唯一自带 SUSFS 的分支（main 是模块化 v4 树，给 GKI 用的）
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
# 4.14 上 kprobes 不可靠，这是"管理器显示已安装但 su 无反应"的头号原因
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
# =================================================================== SUSFS ==
# 先关掉。Non-GKI 的 susfs 补丁 2025 年初后没再更新，仍按旧的扁平目录结构打，
# 容易和新的模块化 KernelSU 目录对不上。等无 SUSFS 版本能开机了再开。
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto
# ========================================================== Extra patches ===
# path_umount() 是 5.9 才有的函数，4.14 必须回移，否则模块能挂不能卸
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false
# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
# 这棵树的 defconfig 里 CONFIG_LTO_CLANG=y + CONFIG_CFI_CLANG=y，
# 4.14 + clang 做 LTO 既慢又极易失败，先把 LTO 关掉
DISABLE_LTO=true
DISABLE_CC_WERROR=true
# 脚本的 DISABLE_LTO 只处理 CONFIG_LTO*，不碰 CFI_CLANG（它依赖 LTO_CLANG），
# 这里显式关掉，省得 kconfig 反复warning
EXTRA_DEFCONFIG=CONFIG_CFI_CLANG=n
# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
